{
  "name": "tg-to-wa-sticker-bot",
  "version": "1.0.0",
  "description": "Telegram bot to convert Telegram stickers and sticker packs into WhatsApp stickers (.wastickers and .webp)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "caffeinate -i -s -m tsx src/index.ts",
    "build": "tsc",
    "start": "caffeinate -i -s -m node dist/index.js",
    "test": "tsx test-verification.ts",
    "set-webhook": "tsx scripts/set-webhook.ts"
  },
  "keywords": [
    "telegram",
    "whatsapp",
    "sticker",
    "wastickers",
    "telegraf"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/archiver": "^8.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.6.5",
    "archiver": "^8.0.0",
    "dotenv": "^18.0.7",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "sharp": "^0.35.5",
    "telegraf": "^4.16.3",
    "tgs-to": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
